# VoicePilot AI Environment Configuration
HOST=0.0.0.0
PORT=8000
SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
SILENCE_TIMEOUT_MS=500

# Cloud Inference API Keys
GROQ_API_KEY=your_groq_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here

# Mode toggles: If True, uses synthetic fast streaming responses without requiring external API keys
MOCK_MODE=false
DEFAULT_MODEL=llama-3.3-70b-versatile
DEFAULT_VOICE=sonic-english
